/* 总体统计页 · 数值按原型 px × 2.36 换算，与设计稿等比例 */
.stats-page { padding-top: 14rpx; }
.state-hint { text-align: center; color: var(--faint); font-size: 26rpx; padding: 80rpx 0; }

/* 原型 .sum-grid：gap 9、margin 6/0/4；两列（space-between 自动留缝） */
.sum-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin: 14rpx 0 10rpx; }
/* 原型 .sum：padding 14、radius 13 */
.sum {
  width: calc(50% - 11rpx);
  margin-bottom: 19rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 31rpx;
  padding: 33rpx;
}
.sum.big {
  width: 100%;
  background: var(--pine);
  border-color: var(--pine);
  color: #fff;
}
.sum.big .k { color: rgba(255,255,255,.72); }
.sum.big .v { color: #fff; font-size: 80rpx; }
.sum.big .u { color: rgba(255,255,255,.6); }
.sum.wide { width: 100%; }
.sum .k { font-size: 26rpx; color: var(--sub); margin-bottom: 19rpx; }
.sum .v { font-size: 61rpx; font-weight: 700; color: var(--pine); line-height: 1; }
.sum .v.sm { font-size: 40rpx; }
.sum .v.clay, .clay { color: var(--clay); }
.sum .u { font-size: 24rpx; color: var(--faint); font-weight: 400; }
.big-note { font-size: 25rpx; color: rgba(255,255,255,.6); margin-top: 14rpx; }
.faint { color: var(--faint); }

/* 图形卡片：原型 .chart padding 14、radius 13 */
.chart {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 31rpx;
  padding: 33rpx;
}
.chart .ct { font-size: 28rpx; font-weight: 600; margin-bottom: 33rpx; }
.chart-empty { text-align: center; color: var(--faint); font-size: 26rpx; padding: 40rpx 0; }

/* 柱状图：原型 height 96、gap 6、bar max-width 22 */
.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 227rpx;
  gap: 14rpx;
  border-bottom: 1rpx solid var(--line);
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.bar-col .bv {
  width: 100%;
  max-width: 52rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: var(--pine);
  min-height: 4rpx;
}
.bar-col .bv.hot { background: var(--clay); }
.bar-col .bl { font-size: 22rpx; color: var(--faint); margin-top: 14rpx; }

/* 横向条形图：原型 track 9、radius 6、row 11 */
.hbar { margin-bottom: 26rpx; }
.hbar .row { display: flex; justify-content: space-between; font-size: 26rpx; margin-bottom: 12rpx; }
.hbar .track { height: 21rpx; background: var(--mist-soft); border-radius: 999rpx; overflow: hidden; }
.hbar .fill { height: 100%; background: var(--sage); border-radius: 999rpx; }
.hbar .fill.hot { background: var(--clay); }

/* 空态 */
.empty { text-align: center; padding: 140rpx 40rpx; }
.empty-ic { font-size: 90rpx; color: var(--mist); line-height: 1; }
.empty-title { font-size: 32rpx; font-weight: 600; margin-top: 26rpx; }
.empty-sub { font-size: 26rpx; color: var(--sub); margin-top: 12rpx; }
