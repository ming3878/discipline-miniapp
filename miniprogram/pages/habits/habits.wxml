<view class="page habits-page">
  <view wx:if="{{loading}}" class="state-hint">加载中…</view>

  <block wx:else>
    <!-- 空态 -->
    <view wx:if="{{habits.length === 0}}" class="empty">
      <view class="empty-ic">◌</view>
      <view class="empty-title">还没有戒断目标</view>
      <view class="empty-sub">先建一个戒断目标，从今天开始算</view>
    </view>

    <!-- 戒断目标列表：编辑 + 更多（上移/下移/删除） -->
    <view wx:for="{{habits}}" wx:key="_id" class="mgmt-item">
      <view class="emoji">{{item.icon}}</view>
      <view class="info">
        <view class="nm">{{item.name}}</view>
        <view class="meta num">始于 {{item.startShort}} · {{item.periodText}} ≤ {{item.limit}} 次</view>
      </view>
      <view class="icon-btn" data-id="{{item._id}}" bindtap="editHabit">✎</view>
      <view class="icon-btn" data-index="{{index}}" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="moreActions">⋮⋮</view>
    </view>

    <!-- 新增入口 -->
    <view class="add-dash" bindtap="addHabit">＋ 新增戒断目标</view>
  </block>

  <!-- 编辑/新增表单（内嵌弹层） -->
  <view wx:if="{{showForm}}" class="form-mask" bindtap="closeForm">
    <view class="form-panel" catchtap="noop">
      <view class="form-head">
        <view class="form-title">{{isEdit ? '编辑戒断目标' : '新增戒断目标'}}</view>
        <view class="form-close" bindtap="closeForm">✕</view>
      </view>

      <scroll-view scroll-y class="form-body">
        <!-- emoji 选择：固定 8 列 × 2 行，全部可见无需滑动 -->
        <view class="field">
          <label>图标</label>
          <view class="emoji-grid">
            <view
              wx:for="{{emojis}}"
              wx:key="*this"
              class="emoji-opt {{form.icon === item ? 'sel' : ''}}"
              data-icon="{{item}}"
              bindtap="pickEmoji"
            >{{item}}</view>
          </view>
        </view>

        <!-- 标题 -->
        <view class="field">
          <label>标题 <text class="req">*</text></label>
          <input class="field-input" value="{{form.name}}" bindinput="onNameInput" placeholder="如：戒烟" placeholder-class="ph" maxlength="20" />
        </view>

        <!-- 副标题 -->
        <view class="field">
          <label>副标题 <text class="faint">（选填）</text></label>
          <input class="field-input" value="{{form.subtitle}}" bindinput="onSubInput" placeholder="如：为了健康" placeholder-class="ph" maxlength="40" />
        </view>

        <!-- 开始日期 C4 -->
        <view class="field">
          <label>从哪天开始戒</label>
          <picker mode="date" value="{{form.startDate}}" start="2000-01-01" end="{{editMaxDate}}" bindchange="onStartChange">
            <view class="input">
              <text class="num">{{form.startDate}}</text>
              <text class="arrow">▾</text>
            </view>
          </picker>
          <view wx:if="{{isEdit && editMaxDate}}" class="field-hint">不得晚于最早破戒记录 {{editMaxDate}}</view>
        </view>

        <!-- 周期 C5 -->
        <view class="field">
          <label>目标周期</label>
          <picker mode="selector" range="{{periods}}" range-key="label" value="{{form.periodType === 'day' ? 0 : (form.periodType === 'week' ? 1 : 2)}}" bindchange="onPeriodChange">
            <view class="input">
              <text>{{form.periodType === 'day' ? '每天' : (form.periodType === 'week' ? '每周' : '每月')}}</text>
              <text class="arrow">▾</text>
            </view>
          </picker>
          <view class="field-hint">按自然{{form.periodType === 'day' ? '天' : (form.periodType === 'week' ? '周' : '月')}}计算，周期内破戒次数不超过上限即为达成</view>
        </view>

        <!-- 上限 X：计步器 -->
        <view class="field">
          <label>上限次数 X</label>
          <view class="stepper">
            <view class="step-btn {{form.limit <= 1 ? 'dis' : ''}}" bindtap="minusLimit">−</view>
            <view class="step-val">
              <text class="n num">{{form.limit}}</text>
              <text class="u">次 / {{form.periodType === 'day' ? '天' : (form.periodType === 'week' ? '周' : '月')}}</text>
            </view>
            <view class="step-btn {{form.limit >= 99 ? 'dis' : ''}}" bindtap="plusLimit">+</view>
          </view>
          <view class="field-hint">上限至少 1 次，破戒次数超过上限才算失败。完全戒断也设为 1。</view>
        </view>
      </scroll-view>

      <view class="form-foot">
        <view class="btn-cancel" bindtap="closeForm">取消</view>
        <view class="btn-primary" bindtap="saveHabit">{{isEdit ? '保存修改' : '创建戒断目标'}}</view>
      </view>
    </view>
  </view>
</view>
