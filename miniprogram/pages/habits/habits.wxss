/* 主题管理页 · 数值按原型 px × 2.36 换算，与设计稿等比例 */
.habits-page { padding-top: 14rpx; }
.state-hint { text-align: center; color: var(--faint); font-size: 26rpx; padding: 80rpx 0; }

/* 原型 .mgmt-item：padding 13/14、radius 13、gap 11、margin-bottom 10 */
.mgmt-item {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 31rpx 33rpx;
  border: 1rpx solid var(--line);
  border-radius: 31rpx;
  background: var(--surface);
  margin-bottom: 24rpx;
}
/* 原型 .emoji：38、radius 11、font 19 */
.mgmt-item .emoji {
  width: 90rpx; height: 90rpx; border-radius: 26rpx;
  background: var(--paper); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 45rpx; flex-shrink: 0;
}
.mgmt-item .info { flex: 1; min-width: 0; }
.mgmt-item .nm { font-size: 33rpx; font-weight: 600; }
.mgmt-item .meta { font-size: 26rpx; color: var(--sub); margin-top: 7rpx; }

/* 原型 .icon-btn：30×30、radius 8、font 14 */
.icon-btn {
  width: 71rpx; height: 71rpx; border-radius: 19rpx;
  background: var(--paper); color: var(--sub);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; border: 1rpx solid var(--line); flex-shrink: 0;
}
.icon-btn.del { color: var(--clay); }

/* 原型 .add-dash：padding 14、radius 13、font 13、1.5px 虚线 */
.add-dash {
  border: 4rpx dashed var(--sage);
  border-radius: 31rpx;
  padding: 33rpx;
  text-align: center;
  color: var(--sage);
  font-size: 31rpx;
  font-weight: 600;
  background: var(--sage-soft);
  margin-top: 10rpx;
}

/* 空态 */
.empty { text-align: center; padding: 90rpx 30rpx 50rpx; }
.empty-ic { font-size: 90rpx; color: var(--mist); line-height: 1; }
.empty-title { font-size: 32rpx; font-weight: 600; margin-top: 26rpx; }
.empty-sub { font-size: 26rpx; color: var(--sub); margin-top: 12rpx; }

/* ---------- 表单弹层 ---------- */
.form-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(31, 42, 38, .42);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.form-panel {
  width: 100%;
  height: 86vh;
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}
.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 38rpx 20rpx;
}
.form-title { font-size: 36rpx; font-weight: 700; }
.form-close { font-size: 32rpx; color: var(--sub); padding: 8rpx 16rpx; }
/* 内容区：固定 basis 0 + 可伸缩，保证 scroll-view 拿到确定高度、页脚永远可见 */
.form-body { flex: 1 1 0; height: 0; min-height: 0; padding: 8rpx 38rpx 16rpx; box-sizing: border-box; }
.form-foot {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 38rpx 48rpx;
  border-top: 1rpx solid var(--line);
  background: var(--paper);
}
.form-foot .btn-primary { flex: 2; }
.btn-cancel {
  flex: 1;
  background: var(--mist-soft);
  color: var(--sub);
  border-radius: var(--rs);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 原型 .field：margin-bottom 20、label 12、label margin-bottom 8 */
.field { margin-bottom: 31rpx; }
.field label { display: block; font-size: 26rpx; font-weight: 600; margin-bottom: 14rpx; }
.field .req { color: var(--clay); }
.field .faint { color: var(--faint); font-weight: 400; }
.field-hint { font-size: 25rpx; color: var(--faint); margin-top: 12rpx; line-height: 1.5; }

/* 原生 input 必须定高 + 行高，不能用 flex（微信里会裁切文字） */
.field-input {
  width: 100%;
  height: 94rpx;
  line-height: 94rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--mist);
  background: #fff;
  border-radius: 26rpx;
  font-size: 30rpx;
  color: var(--ink);
  box-sizing: border-box;
}

/* picker 展示行（纯 view，可用 flex 做左右分布） */
.input {
  width: 100%;
  border: 2rpx solid var(--mist);
  background: #fff;
  border-radius: 26rpx;
  padding: 26rpx 28rpx;
  font-size: 30rpx;
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.input .arrow { color: var(--faint); font-size: 26rpx; }
.ph { color: var(--faint); }

/* emoji：固定 8 列弹性换行（不用 grid，避免小程序端错位） */
.emoji-grid { display: flex; flex-wrap: wrap; }
.emoji-opt {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc((100% - 98rpx) / 8);
  height: 80rpx;
  margin: 0 14rpx 14rpx 0;
  flex: 0 0 auto;
  border-radius: 19rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  font-size: 38rpx;
  box-sizing: border-box;
}
.emoji-opt:nth-child(8n) { margin-right: 0; }
.emoji-opt.sel {
  border-color: var(--pine);
  background: var(--sage-soft);
  box-shadow: 0 0 0 2rpx rgba(35, 70, 59, .18);
}

/* 上限次数计步器：与记录页同一套尺寸 */
.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 2rpx solid var(--mist);
  border-radius: 26rpx;
  padding: 14rpx;
  box-sizing: border-box;
}
.step-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  color: var(--pine);
  font-size: 48rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-btn.dis { color: var(--mist); }
.step-val { display: flex; align-items: baseline; }
.step-val .n { font-size: 48rpx; font-weight: 700; color: var(--pine); line-height: 1; }
.step-val .u { font-size: 26rpx; color: var(--sub); margin-left: 8rpx; }
