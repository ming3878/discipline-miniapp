.index-page { padding-bottom: 40rpx; }

/* 顶部问候 */
.hero { padding: 12rpx 4rpx 28rpx; }
.hero .date { font-size: 24rpx; color: var(--sub); }
.hero .greet { font-size: 44rpx; font-weight: 700; letter-spacing: -.02em; margin-top: 8rpx; }
.hero .hero-sub { font-size: 24rpx; color: var(--faint); margin-top: 8rpx; }

.state-hint { text-align: center; color: var(--faint); font-size: 26rpx; padding: 80rpx 0; }

/* 空态 */
.empty { text-align: center; padding: 120rpx 40rpx; }
.empty-ic { font-size: 88rpx; color: var(--mist); line-height: 1; }
.empty-title { font-size: 32rpx; font-weight: 600; margin-top: 24rpx; }
.empty-sub { font-size: 26rpx; color: var(--sub); margin-top: 12rpx; }
.empty-btn {
  display: inline-block;
  margin-top: 36rpx;
  background: var(--pine);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 48rpx;
  border-radius: var(--rs);
}

/* 记录卡 */
.habit {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r);
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.habit-top { display: flex; align-items: flex-start; justify-content: space-between; }
.habit-id { display: flex; align-items: center; gap: 20rpx; }
.emoji {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  border: 1rpx solid var(--line);
  flex-shrink: 0;
}
.habit-name { font-size: 30rpx; font-weight: 600; }
.habit-sub { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }

/* 当前已戒 */
.streak-row { display: flex; align-items: baseline; gap: 12rpx; margin: 28rpx 0 4rpx; }
.streak-num { font-size: 68rpx; font-weight: 700; color: var(--pine); line-height: 1; }
.streak-unit { font-size: 24rpx; color: var(--sub); }

/* 一周状态条：flex + 百分比宽度（小程序对 grid 支持不稳，避免错位） */
.week { display: flex; margin-top: 24rpx; }
.week .day { flex: 1 1 0; min-width: 0; text-align: center; margin-right: 10rpx; }
.week .day:last-child { margin-right: 0; }
.day .lbl { font-size: 20rpx; color: var(--faint); margin-bottom: 10rpx; }
.day .lbl.today { color: var(--pine); font-weight: 700; }
.bar { height: 40rpx; border-radius: 10rpx; }

/* 底部 */
.habit-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}
.habit-foot .cnt { font-size: 24rpx; color: var(--sub); }
.habit-foot .cnt b { font-size: 26rpx; }
.cnt-clay { color: var(--clay); }
.rec-btn {
  background: var(--pine);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 16rpx 28rpx;
  border-radius: 18rpx;
}
