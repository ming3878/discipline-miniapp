<view class="page records-page">
  <!-- 月份筛选 -->
  <view class="filter">
    <text class="num">{{months.length > 1 ? months[monthIndex].label : '全部'}}</text>
    <picker mode="selector" range="{{months}}" range-key="label" value="{{monthIndex}}" bindchange="onMonthChange">
      <text class="arr num">筛选 ▾</text>
    </picker>
  </view>

  <!-- 空态 -->
  <view wx:if="{{displayRecords.length === 0}}" class="empty">
    <view class="empty-ic">◌</view>
    <view class="empty-title">该戒断目标还没有破戒记录</view>
    <view class="empty-sub">保持住，就是最好的状态</view>
  </view>

  <block wx:else>
    <!-- 记录列表 -->
    <view wx:for="{{displayRecords}}" wx:key="_id" class="log-item">
      <view class="log-date">
        <view class="d num">{{item.dayDisplay}}</view>
        <view class="m num">{{item.monthDisplay}}月</view>
      </view>
      <view class="log-main">
        <view class="c num">破戒 {{item.count}} 次</view>
        <view wx:if="{{item.note}}" class="note">{{item.note}}</view>
        <view wx:else class="note faint">—</view>
      </view>
      <view hover-class="is-pressed" class="log-del" data-id="{{item._id}}" bindtap="deleteRecord">删除</view>
    </view>

    <view class="list-total">{{totalText}}</view>
  </block>
</view>
