.detail-page { padding-top: 12rpx; }
.state-hint { text-align: center; color: var(--faint); font-size: 26rpx; padding: 80rpx 0; }

/* 主题头 */
.detail-head { display: flex; align-items: center; gap: 24rpx; padding: 8rpx 4rpx 28rpx; }
.detail-head .emoji {
  width: 92rpx; height: 92rpx; border-radius: 26rpx;
  background: var(--surface); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; flex-shrink: 0;
}
.dh-title { font-size: 40rpx; font-weight: 700; }
.dh-sub { font-size: 22rpx; color: var(--sub); margin-top: 6rpx; }

/* 指标网格 */
.metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.metric {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
}
.metric .k { font-size: 21rpx; color: var(--sub); margin-bottom: 12rpx; }
.metric .v { font-size: 40rpx; font-weight: 700; color: var(--pine); line-height: 1; }
.metric .v.sm { font-size: 30rpx; }
.metric .v.clay { color: var(--clay); }
.metric .u { font-size: 20rpx; color: var(--faint); font-weight: 400; }
.metric.link .v { color: var(--sub); font-size: 28rpx; }
.metric-note { font-size: 20rpx; color: var(--faint); margin-top: 16rpx; line-height: 1.5; padding: 0 4rpx; }

/* 月历 */
.cal-card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
}
.cal-head { display: flex; justify-content: space-between; align-items: center; padding: 0 4rpx 20rpx; }
.cal-head .m { font-size: 28rpx; font-weight: 600; }
.cal-nav { display: flex; gap: 12rpx; }
.cal-nav-btn {
  width: 52rpx; height: 52rpx; border-radius: 14rpx;
  background: var(--surface); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: var(--sub);
}
.cal-nav-btn.disabled { color: var(--mist); }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; }
.cal-wd { text-align: center; font-size: 20rpx; color: var(--faint); padding-bottom: 12rpx; }
.cal-cell {
  aspect-ratio: 1;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
}
.empty-cell { background: transparent; }
.c-clean { background: var(--sage-soft); color: var(--sage); }
.c-broken { background: var(--clay); color: #fff; }
.c-broken-2 { background: var(--clay-2); color: #fff; }
.c-today { background: var(--indigo); color: #fff; }
.c-future { background: var(--mist-soft); color: var(--faint); }
.c-before { background: transparent; border: 1rpx dashed var(--mist); color: #CFCFC7; box-sizing: border-box; }

.cal-legend { display: flex; gap: 20rpx; flex-wrap: wrap; margin-top: 24rpx; font-size: 20rpx; color: var(--sub); }
.cal-legend view { display: flex; align-items: center; }
.lg { width: 18rpx; height: 18rpx; border-radius: 6rpx; display: inline-block; margin-right: 8rpx; }

/* 日期详情弹窗 */
.cell-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(31, 42, 38, .42);
  z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.cell-panel {
  width: 76%;
  background: var(--surface);
  border-radius: 32rpx;
  padding: 40rpx;
  max-height: 70vh;
}
.cell-date { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.cell-rec { border-top: 1rpx solid var(--line); padding: 20rpx 0; }
.cell-rec-c { font-size: 26rpx; font-weight: 600; color: var(--clay); }
.cell-rec-note { font-size: 24rpx; color: var(--sub); margin-top: 8rpx; line-height: 1.5; }
.cell-none { text-align: center; font-size: 26rpx; color: var(--faint); padding: 24rpx 0; }
.cell-close {
  margin-top: 24rpx;
  background: var(--pine);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}
