/* 单卡统计页 · 数值按原型 px × 2.36 换算，与设计稿等比例 */
.detail-page { padding-top: 14rpx; }
.state-hint { text-align: center; color: var(--faint); font-size: 26rpx; padding: 80rpx 0; }

/* 原型 .detail-head：padding 6/2/16、gap 12；emoji 46、font 22；h2 20；p 11 */
.detail-head { display: flex; align-items: center; gap: 28rpx; padding: 14rpx 5rpx 38rpx; }
.detail-head .emoji {
  width: 109rpx; height: 109rpx; border-radius: 26rpx;
  background: var(--surface); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; flex-shrink: 0;
}
.dh-info { flex: 1; min-width: 0; }
.dh-title { font-size: 47rpx; font-weight: 700; letter-spacing: -.02em; }
.dh-sub { font-size: 26rpx; color: var(--sub); margin-top: 5rpx; }

/* 指标网格：flex 换行 + 三等分（避免 grid 在小程序端的错位） */
.metrics { display: flex; flex-wrap: wrap; }
.metric {
  width: calc((100% - 38rpx) / 3);
  margin: 0 19rpx 19rpx 0;
  box-sizing: border-box;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
}
.metric:nth-child(3n) { margin-right: 0; }
.metric .k { font-size: 25rpx; color: var(--sub); margin-bottom: 14rpx; }
.metric .v { font-size: 47rpx; font-weight: 700; color: var(--pine); line-height: 1; }
.metric .v.sm { font-size: 35rpx; }
.metric .v.clay { color: var(--clay); }
.metric .u { font-size: 24rpx; color: var(--faint); font-weight: 400; }
.metric.link .v { color: var(--sub); font-size: 31rpx; padding-top: 9rpx; }

/* 月历：标题行在卡片外，卡片内只有网格 + 图例 */
.cal-head { display: flex; justify-content: space-between; align-items: center; padding: 0 5rpx 24rpx; }
.cal-head .m { font-size: 33rpx; font-weight: 600; }
.cal-nav { display: flex; gap: 14rpx; }
.cal-nav-btn {
  width: 61rpx; height: 61rpx; border-radius: 17rpx;
  background: var(--surface); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 31rpx; color: var(--sub);
}
.cal-nav-btn.disabled { color: var(--mist); }
.cal {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 33rpx;
  padding: 28rpx;
}
/* 月历：flex 换行，每行固定 7 格（不用 grid，避免错位） */
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-wd {
  width: calc((100% - 72rpx) / 7);
  margin-right: 12rpx;
  text-align: center; font-size: 24rpx; color: var(--faint); padding-bottom: 14rpx;
}
.cal-cell {
  width: calc((100% - 72rpx) / 7);
  height: 78rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}
/* 每行第 7 格去掉右外边距，保证 7 格正好铺满一行 */
.cal-wd:nth-child(7n), .cal-cell:nth-child(7n) { margin-right: 0; }
.empty-cell { background: transparent; }
.c-clean { background: var(--sage-soft); color: var(--sage); }
.c-broken { background: var(--clay); color: #fff; }
.c-broken-2 { background: var(--clay-2); color: #fff; }
.c-today { background: var(--indigo); color: #fff; }
.c-future { background: var(--mist-soft); color: var(--faint); }
.c-before { background: transparent; border: 1rpx dashed var(--mist); color: #CFCFC7; box-sizing: border-box; }

.cal-legend { display: flex; gap: 24rpx; flex-wrap: wrap; margin-top: 28rpx; font-size: 24rpx; color: var(--sub); }
.cal-legend view { display: flex; align-items: center; }
.lg { width: 21rpx; height: 21rpx; border-radius: 7rpx; display: inline-block; margin-right: 8rpx; }

/* 日期详情弹窗 */
.cell-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(31, 42, 38, .42);
  z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.cell-panel {
  width: 76%;
  background: var(--surface);
  border-radius: 32rpx;
  padding: 40rpx;
  max-height: 70vh;
}
.cell-date { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.cell-rec { border-top: 1rpx solid var(--line); padding: 20rpx 0; }
.cell-rec-c { font-size: 28rpx; font-weight: 600; color: var(--clay); }
.cell-rec-note { font-size: 26rpx; color: var(--sub); margin-top: 8rpx; line-height: 1.5; }
.cell-none { text-align: center; font-size: 28rpx; color: var(--faint); padding: 24rpx 0; }
.cell-close {
  margin-top: 24rpx;
  background: var(--pine);
  color: #fff;
  text-align: center;
  padding: 22rpx;
  border-radius: var(--rs);
  font-size: 28rpx;
  font-weight: 600;
}
