/* 记录页 · 数值按原型 px × 2.36 换算，与设计稿等比例 */
.record-page { padding-top: 14rpx; }

/* 原型 .target-strip：padding 12/14、gap 10、radius 12、margin-bottom 18 */
.target-strip {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--sage-soft);
  border-radius: 28rpx;
  margin-bottom: 42rpx;
}
.target-strip .emoji {
  width: 90rpx; height: 90rpx; border-radius: 26rpx;
  background: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; flex-shrink: 0;
}
.target-strip .t { font-size: 30rpx; font-weight: 600; color: var(--pine); }
.target-strip .hint { font-size: 26rpx; color: var(--sage); margin-top: 6rpx; }

/* 原型 .form-card padding 18、radius 16 */
.form-card { padding: 42rpx; }

/* 原型 .field margin-bottom 20、label 12px、label margin-bottom 8px */
.field { margin-bottom: 46rpx; }
.field label { display: block; font-size: 28rpx; font-weight: 600; margin-bottom: 18rpx; color: var(--ink); }
.field .req { color: var(--clay); }
.field-hint { font-size: 24rpx; color: var(--faint); margin-top: 14rpx; line-height: 1.5; }

/* 原型 .input：padding 13/14、radius 11、font 14 */
.input {
  width: 100%;
  border: 2rpx solid var(--mist);
  background: #fff;
  border-radius: 26rpx;
  padding: 30rpx 32rpx;
  font-size: 32rpx;
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.input .change { color: var(--pine); font-size: 26rpx; font-weight: 600; }
.input .ph { color: var(--faint); }

/* 原型 .stepper：padding 6、radius 11；button 36px、font 20px、radius 8 */
.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid var(--mist);
  border-radius: 26rpx;
  background: #fff;
  padding: 14rpx;
}
.step-btn {
  width: 84rpx; height: 84rpx; border-radius: 18rpx;
  background: var(--paper); color: var(--pine);
  font-size: 48rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid var(--line);
}
.step-n { font-size: 48rpx; font-weight: 700; color: var(--ink); }

/* 到达上下限时置灰，避免用户连点无效 */
.step-btn.off {
  color: var(--faint);
  background: #fff;
  border-color: var(--mist);
}

/* 原型 .note-area：min-height 76px、padding 12/14、font 13 */
.note-area {
  width: 100%;
  height: 180rpx;
  line-height: 1.6;
  border: 2rpx solid var(--mist);
  background: #fff;
  border-radius: 26rpx;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: var(--ink);
  box-sizing: border-box;
}
.ph { color: var(--faint); }

/* 原型 .save：padding 14、radius 12、font 14 */
.save {
  width: 100%;
  box-sizing: border-box; /* 缺这行会导致 100% + padding 撑破卡片右边界 */
  padding: 32rpx;
  border-radius: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: var(--pine);
  text-align: center;
  margin-top: 10rpx;
}
